# Copy to .env.local for local development, or set these in Vercel → Project → Settings → Environment Variables.
# All variables are server-side only. Never prefix them with NEXT_PUBLIC_.

# --- AI provider (optional) --------------------------------------------------------------
# Without a key, SIP Saathi runs in clearly labelled "educational demo mode" (preapproved content, no AI calls).
# Provider: gemini (preferred) or anthropic. If unset, Gemini is used when GEMINI_API_KEY is present.
AI_PROVIDER=gemini
GEMINI_API_KEY=
# Optional model override (default gemini-3.5-flash-lite) and per-instance request pacing (default 10/min)
GEMINI_MODEL=
GEMINI_RPM=
GEMINI_CONCURRENCY=

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
# low | medium | high (default low)
ANTHROPIC_EFFORT=

# AI_MODE=demo forces demo mode even when a key is set (useful for quota-free deploys and E2E tests).
AI_MODE=
# AI_JUDGE=off disables the separate AI quality judge (it can only block, never approve).
AI_JUDGE=

# --- Storage (recommended on Vercel) -------------------------------------------------------
# Evaluation runs, human reviews, scenario cache and event counts. Locally they go to .data/ when these are empty.
# On Vercel without Redis they are kept in memory and lost on cold starts (the UI says so).
# The Vercel Upstash integration may name these KV_REST_API_URL / KV_REST_API_TOKEN; both are accepted.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Protection for a public deployment ----------------------------------------------------
# Required on Vercel to save human reviews (they write shared data). Anyone can run the evaluation suite without it.
ADMIN_TOKEN=
# Salt for hashing client IPs in the rate limiter (IPs are never stored raw).
RATE_LIMIT_SALT=
